  "independent_FD_fixture_source": {
    "bytes": 5523,
    "distinction": "SystemExit with an unrelated live descriptor, plus actual FD-number reuse after stream exit for success, digest rejection and partial-read failure.",
    "filename": "test_fd_ownership.py",
    "group_attempts": 1,
    "logical_cases": 4,
    "sha256": "3e7c18c47cf1212c297f0dc99057323fb3fd2e3f5ea33a83fd17960a4f1726f3",
    "source_utf8": "\"\"\"Four original R3 ownership checks; no corpus, model or resource-exhaustion loop.\"\"\"\n\nimport errno\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\n\nimport pytest\n\nfrom toolalign.data.common import DataError\nfrom toolalign.training.sft import data_v3 as v\n\n\ndef assert_closed(fd):\n    with pytest.raises(OSError) as raised:\n        os.fstat(fd)\n    assert raised.value.errno == errno.EBADF\n\n\ndef test_system_exit_during_construction_closes_only_owned_descriptor(tmp_path, monkeypatch):\n    source = tmp_path / \"owned-constructor-input\"\n    source.write_bytes(b\"R1 original constructor fixture\")\n    unrelated = tmp_path / \"unrelated-open-file\"\n    unrelated.write_bytes(b\"R1 unrelated descriptor must remain usable\")\n    open_fd, close_fd = os.open, os.close\n    sentinel = open_fd(unrelated, os.O_RDONLY)\n    opened, closed = [], []\n    original = SystemExit(\"R1 original constructor exit\")\n\n    def failed_constructor(fd, mode):\n        assert mode == \"rb\" and fd != sentinel\n        opened.append(fd)\n        raise original\n\n    def observe_close(fd):\n        closed.append(fd)\n        close_fd(fd)\n\n    try:\n        with monkeypatch.context() as patch:\n            patch.setattr(v.os, \"fdopen\", failed_constructor)\n            patch.setattr(v.os, \"close\", observe_close)\n            with pytest.raises(SystemExit) as raised:\n                v._read(source, content=False)\n        assert raised.value is original and len(opened) == 1 and closed == opened\n        assert_closed(opened[0])\n        assert os.fstat(sentinel).st_ino == unrelated.stat().st_ino\n        assert os.read(sentinel, 100) == unrelated.read_bytes()\n        (tmp_path / \"result.json\").write_text(json.dumps({\n            \"case\": \"system_exit_constructor\", \"original_exception_identity_preserved\": True,\n            \"owned_descriptor_closed\": True, \"unrelated_descriptor_open\": True,\n        }, sort_keys=True) + \"\\n\")\n    finally:\n        close_fd(sentinel)\n        for fd in opened:\n            try:\n                close_fd(fd)\n            except OSError as error:\n                assert error.errno == errno.EBADF\n\n\n@pytest.mark.parametrize(\"outcome\", [\"success\", \"digest_error\", \"partial_read_error\"])\ndef test_stream_exit_does_not_close_reused_descriptor(tmp_path, monkeypatch, outcome):\n    source = tmp_path / \"owned-stream-input\"\n    payload = b\"R1 original stream fixture\\x00\\xff\\n\"\n    if outcome == \"partial_read_error\":\n        payload = b\"R\" * (1024 * 1024) + b\"1\"\n    source.write_bytes(payload)\n    sentinel_path = tmp_path / \"new-owner-after-stream-exit\"\n    sentinel_path.write_bytes(b\"R1 new owner retains the reused descriptor\")\n    original_fdopen, original_open, original_close = os.fdopen, os.open, os.close\n    original = OSError(errno.EIO, \"R1 error after one actual read\")\n    streams, reused, reads, closes, exits = [], [], [], [], []\n\n    class StreamWithNewOwnerOnExit:\n        def __init__(self, fd, mode):\n            self.fd = fd\n            self.raw = original_fdopen(fd, mode)\n            streams.append(self)\n\n        def __enter__(self):\n            self.raw.__enter__()\n            return self\n\n        def __exit__(self, *args):\n            exits.append(args[0])\n            result = self.raw.__exit__(*args)\n            assert self.raw.closed\n            assert_closed(self.fd)\n            new_fd = original_open(sentinel_path, os.O_RDONLY)\n            if new_fd != self.fd:\n                os.dup2(new_fd, self.fd)\n                original_close(new_fd)\n            reused.append(self.fd)\n            return result\n\n        def fileno(self):\n            return self.raw.fileno()\n\n        def read(self, size):\n            if outcome == \"partial_read_error\" and reads:\n                raise original\n            block = self.raw.read(size)\n            reads.append(len(block))\n            return block\n\n    def observe_close(fd):\n        closes.append(fd)\n        original_close(fd)\n\n    try:\n        with monkeypatch.context() as patch:\n            patch.setattr(v.os, \"fdopen\", StreamWithNewOwnerOnExit)\n            patch.setattr(v.os, \"close\", observe_close)\n            if outcome == \"success\":\n                assert v._read(source, digest=hashlib.sha256(payload).hexdigest()) == payload\n            elif outcome == \"digest_error\":\n                with pytest.raises(DataError, match=\"^v3_input_hash_mismatch$\"):\n                    v._read(source, digest=\"0\" * 64)\n            else:\n                with pytest.raises(DataError, match=\"^v3_input_io_failure$\") as raised:\n                    v._read(source)\n                assert raised.value.__cause__ is original and reads == [1024 * 1024]\n        assert len(streams) == len(reused) == len(exits) == 1 and closes == []\n        assert streams[0].raw.closed and reused[0] == streams[0].fd\n        assert os.fstat(reused[0]).st_ino == sentinel_path.stat().st_ino\n        assert os.read(reused[0], 100) == sentinel_path.read_bytes()\n        (tmp_path / \"result.json\").write_text(json.dumps({\n            \"case\": outcome, \"original_stream_closed\": True,\n            \"same_descriptor_reassigned_to_new_owner\": True, \"new_owner_still_open\": True,\n            \"raw_close_calls_after_transfer\": closes, \"actual_read_sizes\": reads,\n        }, sort_keys=True) + \"\\n\")\n    finally:\n        for stream in streams:\n            if not stream.raw.closed:\n                stream.raw.close()\n        for fd in reused:\n            try:\n                original_close(fd)\n            except OSError as error:\n                assert error.errno == errno.EBADF\n"
  },
